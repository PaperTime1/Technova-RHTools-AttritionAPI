# Copier ce fichier en .env (ignoré par Git) et renseigner les valeurs.
# Aucune valeur réelle ne doit figurer ici.

# ═══ Base de données ═══
DATABASE_URL=postgresql+psycopg://<utilisateur>:<mot_de_passe>@localhost:5432/technova_attrition

# ═══ API ═══
API_HOST=0.0.0.0
API_PORT=8000
# development | test | staging | production
ENVIRONMENT=development

# ═══ Modèle ═══
MODEL_PATH=artifacts/modele_final.joblib
SCALER_PATH=artifacts/scaler_sel.joblib
FEATURES_PATH=artifacts/features_finales.joblib
THRESHOLD_PATH=artifacts/seuil_final.joblib

# Les clés d'API ne se configurent pas ici : elles sont générées par
#   python scripts/create_api_client.py --name <client> [--role admin]
# et seule leur empreinte SHA-256 est stockée en base.
# Base de test (optionnel) : TEST_DATABASE_URL=postgresql+psycopg://...
